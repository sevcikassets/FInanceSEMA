# Local dev defaults (docker-compose.yml). For production
# (docker-compose.prod.yml) only POSTGRES_*, FINANCE_APP_*, and DOMAIN
# matter - API_CORS_ORIGINS/NEXT_PUBLIC_API_URL are derived from DOMAIN
# automatically there and can be left as-is below.
POSTGRES_DB=finance_sema
POSTGRES_USER=finance
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://finance:change-me@db:5432/finance_sema
API_CORS_ORIGINS=http://localhost:3010

# Admin login seeded on first startup (ensure_admin_user). Change the
# password before going live, and turn on 2FA for this account right
# after (Uzivatele tab -> "Zapnout 2FA") - the app holds sensitive
# financial data.
FINANCE_APP_USERNAME=admin
FINANCE_APP_PASSWORD=change-me

# Signs login/session JWTs - must be a long random secret, never the
# default below, and never committed anywhere. Generate one with:
#   openssl rand -hex 32
FINANCE_APP_TOKEN_SECRET=change-this-secret

NEXT_PUBLIC_API_URL=http://localhost:8010

# Production only (docker-compose.prod.yml): public domain the app is
# served from behind Traefik/HTTPS. Also used to build API_CORS_ORIGINS
# and NEXT_PUBLIC_API_URL for that deployment - see docs/AWS_DEPLOYMENT.md.
DOMAIN=finance.sevcikassets.cz
