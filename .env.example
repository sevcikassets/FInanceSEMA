# Local dev defaults (docker-compose.yml). For production
# (docker-compose.prod.yml) only POSTGRES_*, FINANCE_APP_*, and DOMAIN
# matter - API_CORS_ORIGINS/NEXT_PUBLIC_API_URL are derived from DOMAIN
# automatically there and can be left as-is below.
POSTGRES_DB=finance_sema
POSTGRES_USER=finance
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://finance:change-me@db:5432/finance_sema

# Read-only connection to the Activities app's own Postgres (a separate
# app on the same host - see activities_db.py). Required in production
# (docker-compose.prod.yml) - deploy fails fast without it rather than
# silently trying dev credentials against a real database. The host is
# always "activities-db" (a network alias, not a real hostname - see
# shared_infra in both apps' docker-compose.yml); user/password/db name
# must match Activities' OWN POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB
# from ITS .env on this same server, not this app's. Also requires a
# one-time `docker network create shared_infra` on the server.
ACTIVITIES_DATABASE_URL=postgresql+psycopg://activities:activities@activities-db:5432/activities

API_CORS_ORIGINS=http://localhost:3010
API_ENABLE_DOCS=true
API_ALLOWED_HOSTS=*
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# Admin login seeded on first startup (ensure_admin_user). Change the
# password before going live, and turn on 2FA for this account right
# after (Uzivatele tab -> "Zapnout 2FA") - the app holds sensitive
# financial data.
FINANCE_APP_USERNAME=admin
FINANCE_APP_PASSWORD=change-me

# Signs login/session JWTs - must be a long random secret, never the
# default below, and never committed anywhere. Generate one with:
#   openssl rand -hex 32
FINANCE_APP_TOKEN_SECRET=change-this-secret

NEXT_PUBLIC_API_URL=http://localhost:8010

# E-mailové reporty (Subjekty tab -> "E-mailové reporty", viz
# api/app/email_reports.py). Leave SMTP_HOST empty to disable sending
# entirely - portfolios can still have a period configured, but the
# scheduled job will fail loudly in the API logs instead of silently
# doing nothing, so you'll notice if it's misconfigured.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USERNAME=you@gmail.com,
# SMTP_PASSWORD=<app password, not your normal password>, SMTP_FROM=you@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Production only (docker-compose.prod.yml): public domain the app is
# served from behind Traefik/HTTPS. Also used to build API_CORS_ORIGINS
# and NEXT_PUBLIC_API_URL for that deployment - see docs/AWS_DEPLOYMENT.md.
DOMAIN=finance.sevcikassets.cz
